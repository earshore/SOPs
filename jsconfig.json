{
    "compilerOptions": {
        "checkJs": true,
        "strict": false,
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@common/*": ["./src/common/*"],
            "@services/*": ["./src/services/*"],
            "@modules/*": ["./src/modules/*"],
            "@components/*": ["./src/components/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
