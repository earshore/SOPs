{
    "name": "aihang-sop",
    "version": "1.0.0",
    "description": "Amazing Amazon Architect - 亚马逊运营管理平台",
    "type": "module",
    "scripts": {
        "dev": "vite & sleep 2 && open -na 'Google Chrome' --args --incognito http://localhost:5173",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:build": "vitest run tests/build/build.test.ts",
        "test:build:sourcemap": "vitest run tests/build/sourcemap-enabled.test.ts",
        "test:build:css": "vitest run tests/build/css-extraction.test.ts",
        "test:build:js": "vitest run tests/build/js-minification.test.ts",
        "test:build:all": "vitest run tests/build/",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "lint:report": "tsx tools/eslint-fixer.ts",
        "lint:report:dry": "tsx tools/eslint-fixer.ts --dry-run",
        "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css,md}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx,json,css,md}\"",
        "type-check": "tsc --noEmit",
        "xss:scan": "node tools/xss-scanner.js",
        "xss:fix": "node tools/xss-fixer.js --auto-fix",
        "xss:fix:dry": "node tools/xss-fixer.js --dry-run",
        "security:check": "npm run xss:scan",
        "security:audit": "tsx tools/security-auditor.ts",
        "batch-replace-any": "tsx scripts/batch-replace-any.ts",
        "batch-replace-any:dry": "tsx scripts/batch-replace-any.ts --dry-run",
        "batch-replace-any:safe": "tsx scripts/batch-replace-any.ts --safe-only",
        "lighthouse": "lhci autorun --config=tests/config/lighthouserc.js",
        "lighthouse:local": "lhci autorun --config=tests/config/lighthouserc.js",
        "quality:check": "node tests/quality/code-quality-check.ts",
        "quality:coverage": "node tests/quality/coverage-stats.js",
        "quality:dashboard": "node tests/quality/generate-dashboard.js",
        "quality:baseline": "node tests/quality/run-all-checks.js",
        "quality:track": "tsx scripts/track-quality-progress.ts",
        "replace-console": "tsx scripts/replace-console-statements.ts",
        "tech-debt:scan": "tsx tools/tech-debt-scanner.ts",
        "quality:monitor": "tsx tools/quality-monitor.ts",
        "quality:monitor:ci": "tsx tools/quality-monitor.ts",
        "quality:trend": "tsx tools/quality-monitor.ts",
        "quality:report": "tsx tools/quality-monitor.ts",
        "unused-imports:scan": "tsx tools/unused-imports-cleaner.ts",
        "code:clean:comments": "tsx tools/commented-code-cleaner.ts",
        "code:clean:todos": "tsx tools/todo-cleaner.ts",
        "code:analyze:complexity": "tsx tools/complexity-analyzer.ts",
        "code:clean:all": "npm run code:clean:comments && npm run code:clean:todos && npm run code:analyze:complexity",
        "release:check": "tsx tools/pre-release-checker.ts",
        "release:rollback-plan": "tsx tools/rollback-plan.ts",
        "release:monitoring": "tsx tools/monitoring-config-generator.ts",
        "release:canary-plan": "tsx tools/canary-deployment-plan.ts",
        "release:prepare": "npm run release:check && npm run release:rollback-plan && npm run release:monitoring && npm run release:canary-plan",
        "monitor:crash": "tsx tools/crash-monitor.ts",
        "monitor:performance": "tsx tools/performance-analyzer.ts",
        "maintenance:schedule": "tsx tools/maintenance-scheduler.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:chromium": "playwright test --project=chromium",
        "test:e2e:parallel": "node tests/run-parallel.js",
        "test:e2e:parallel:fast": "node tests/run-parallel.js --workers 4 --skip-firefox --skip-webkit",
        "test:e2e:parallel:all": "node tests/run-parallel.js --enable-mobile",
        "test:e2e:report": "node tests/report-manager.js open",
        "test:e2e:report:generate": "node tests/report-manager.js generate",
        "test:e2e:report:summary": "node tests/report-manager.js summary",
        "test:e2e:report:clean": "node tests/report-manager.js clean",
        "test:e2e:report:archive": "node tests/report-manager.js archive",
        "test:e2e:report:serve": "node tests/report-manager.js serve",
        "test:startup": "playwright test tests/startup",
        "test:performance": "playwright test tests/performance",
        "test:performance:home": "playwright test tests/performance/home-performance.test.ts --project=chromium",
        "test:performance:lighthouse": "playwright test tests/performance/lighthouse.test.ts --grep=\"首页\"",
        "performance:report": "tsx tests/performance/generate-performance-report.ts",
        "test:visual": "playwright test tests/visual",
        "test:visual:update": "playwright test tests/visual --update-snapshots",
        "test:visual:headed": "playwright test tests/visual --headed",
        "test:visual:debug": "playwright test tests/visual --debug",
        "playwright:install": "playwright install",
        "playwright:install:deps": "playwright install --with-deps",
        "playwright:check": "node tests/check-playwright-env.js",
        "screenshots:stats": "tsx tests/scripts/screenshot-stats.ts",
        "screenshots:cleanup": "tsx tests/scripts/cleanup-screenshots.ts",
        "screenshots:cleanup:all": "tsx tests/scripts/cleanup-screenshots.ts --all",
        "screenshots:view": "start tests/screenshots/index.html",
        "generate:tokens": "tsx scripts/generate-all-tokens.ts",
        "generate:css-vars": "tsx scripts/generate-css-variables.ts",
        "generate:tailwind": "tsx scripts/generate-tailwind-config.ts",
        "generate:types": "tsx scripts/generate-design-token-types.ts",
        "css:audit": "tsx scripts/audit-css-variables.ts",
        "css:migrate": "tsx scripts/migrate-deprecated-variables.ts",
        "css:migrate:dry": "tsx scripts/migrate-deprecated-variables.ts --dry-run",
        "css:migrate-hardcoded": "tsx scripts/migrate-hardcoded-values.ts --apply",
        "css:migrate-hardcoded:dry": "tsx scripts/migrate-hardcoded-values.ts",
        "css:analyze": "tsx scripts/analyze-module-css.ts",
        "css:cleanup": "tsx scripts/cleanup-unused-css.ts",
        "docs:api": "node scripts/generate-api-docs.js",
        "docs:serve": "npx http-server docs/api -p 8080 -o"
    },
    "devDependencies": {
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.58.2",
        "@types/marked": "^5.0.2",
        "@types/navigo": "^8.1.1",
        "@types/node": "^20.0.0",
        "@types/pixelmatch": "^5.2.6",
        "@types/pngjs": "^6.0.5",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitest/coverage-v8": "^1.0.0",
        "@vitest/ui": "^1.0.0",
        "autoprefixer": "^10.4.23",
        "docdash": "^2.0.2",
        "eslint": "^8.0.0",
        "fast-check": "^4.5.3",
        "jscpd": "^4.0.5",
        "jsdoc": "^4.0.5",
        "jsdom": "^23.0.0",
        "lightningcss": "^1.31.1",
        "pixelmatch": "^7.1.0",
        "playwright-lighthouse": "^4.0.0",
        "pngjs": "^7.0.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "terser": "^5.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-checker": "^0.6.0",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-singlefile": "^2.3.0",
        "vitest": "^1.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.1.0",
        "alpinejs": "^3.15.5",
        "chart.js": "^4.5.1",
        "clsx": "^2.1.1",
        "gridstack": "^12.4.2",
        "jsonrepair": "^3.13.2",
        "marked": "^17.0.1",
        "navigo": "^8.11.1",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    }
}