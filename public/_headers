/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.bootcdn.net; style-src 'self' 'unsafe-inline' https://cdn.bootcdn.net https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.bootcdn.net https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.scraperapi.com https://api.zenrows.com https://api.brightdata.com https://new.hongecb.store https://*.amazon.com https://*.amazon.de https://*.amazon.co.uk https://*.amazon.fr https://*.amazon.it https://*.amazon.es https://*.amazon.nl https://*.amazon.se https://*.amazon.pl https://*.amazon.be https://*.amazon.ie; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript 模块 MIME 类型
/*.js
  Content-Type: application/javascript; charset=utf-8

/*.mjs
  Content-Type: application/javascript; charset=utf-8

/*.ts
  Content-Type: application/javascript; charset=utf-8

# CSS MIME 类型
/*.css
  Content-Type: text/css; charset=utf-8
