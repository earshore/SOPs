# 环境配置模板
# 复制此文件为 .env.development 或 .env.production 并填写实际值

# 应用环境
VITE_APP_ENV=development

# API 配置
VITE_API_BASE_URL=/v1
VITE_API_TIMEOUT=30000

# 功能开关
VITE_ENABLE_MONITORING=false
VITE_ENABLE_DEBUG=true

# 日志配置
VITE_LOG_LEVEL=debug

# 性能监控
VITE_ENABLE_PERFORMANCE=true

# 监控服务（可选）
# VITE_SENTRY_DSN=

# ============================================================
# 部署前请在 Cloudflare Pages 控制台 → Settings → Environment Variables
# 添加以下生产环境变量：
#
#   AUTH_PASSWORD               = <your-password>
#   GATEWAY_LLMGATEWAY_BASE_URL = https://ai-gateway.hongecb.store/v1
#   GATEWAY_LLMGATEWAY_API_KEY  = <your-key>
#   GATEWAY_CB_BASE_URL         = https://cb.hongecb.store/v1
#   GATEWAY_CB_API_KEY          = <your-key>
#   GATEWAY_CBA_BASE_URL        = https://cba.hongecb.store/v1
#   GATEWAY_CBA_API_KEY         = <your-key>
#   GATEWAY_CB_E_BASE_URL       = https://sds.dpdns.org/v1
#   GATEWAY_CB_E_API_KEY        = <your-key>
#   GATEWAY_KR_BASE_URL         = https://kr.hongecb.store/v1
#   GATEWAY_KR_API_KEY          = <your-key>
#   GATEWAY_GPTGOD_BASE_URL         = https://api.gptgod.online/v1
#   GATEWAY_GPTGOD_API_KEY          = <your-key>
#   GATEWAY_CHATANYWHERE_BASE_URL   = https://api.chatanywhere.org/v1
#   GATEWAY_CHATANYWHERE_API_KEY    = <your-key>
# ============================================================