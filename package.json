{
  "name": "sops",
  "version": "3.0.12-rc.5",
  "description": "sops - 亚马逊运营管理平台",
  "type": "module",
  "scripts": {
    "dev": ".\\scripts\\dev.bat",
    "dev:simple": "vite",
    "dev:open": "vite --open",
    "prebuild": "npm run ci:security && npm run ci:quality",
    "build": "npm run build:app",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"**/*.spec.ts\" --ignore-pattern \"**/*.spec.tsx\"",
    "lint:tests": "eslint \"src/**/*.{test,spec}.{ts,tsx,js,jsx}\" \"tests/**/*.{test,spec}.{ts,tsx,js,jsx}\" --no-error-on-unmatched-pattern --max-warnings=0",
    "lint:performance": "eslint --parser-options project:./config/tsconfig.performance.json config/playwright.config.ts config/playwright.performance.config.ts tests/performance/lighthouse-gate.ts tests/performance/release-performance-gate.test.ts tests/unit/lighthouse-gate.test.ts tests/unit/performance-workflow.test.ts",
    "lint:fix": "eslint src --fix",
    "lint:warning-gate": "tsx scripts/quality/eslint-warning-gate.ts",
    "lint:warning-baseline": "tsx scripts/quality/eslint-warning-gate.ts --update",
    "lint:report": "tsx tools/eslint-fixer.ts",
    "lint:report:dry": "tsx tools/eslint-fixer.ts --dry-run",
    "format": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --write \"src/**/*.{js,ts,jsx,tsx,json,css,md}\"",
    "format:check": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check \"src/**/*.{js,ts,jsx,tsx,json,css,md}\"",
    "format:check:performance": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check package.json .github/workflows/test.yml config/playwright.config.ts config/playwright.performance.config.ts config/tsconfig.performance.json tests/performance/lighthouse-gate.ts tests/performance/release-performance-gate.test.ts",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "type-check:tests": "tsc --noEmit",
    "type-check:performance": "tsc --noEmit -p config/tsconfig.performance.json",
    "xss:scan": "node tools/security/xss-scanner.js",
    "xss:gate": "node tools/security/xss-scanner.js --fail-on high",
    "xss:fix": "node tools/security/xss-fixer.js --auto-fix",
    "xss:fix:dry": "node tools/security/xss-fixer.js --dry-run",
    "security:check": "npm run xss:scan",
    "secret:scan": "tsx tools/secret-leak-scanner.ts",
    "probe:responses": "node tools/probe-responses-gateway.mjs",
    "probe:reasoning": "node tools/probe-reasoning-gateway.mjs",
    "probe:chat": "node tools/probe-chat-gateway.mjs",
    "security:audit": "tsx tools/security-auditor.ts",
    "lighthouse": "npm run test:performance:gate",
    "lighthouse:local": "npm run test:performance:gate",
    "quality:check": "node tests/quality/code-quality-check.ts",
    "quality:coverage": "node tests/quality/coverage-stats.js",
    "quality:regression": "node tests/quality/regression-audit.js",
    "quality:dashboard": "node tests/quality/generate-dashboard.js",
    "quality:baseline": "node tests/quality/run-all-checks.js",
    "quality:track": "tsx scripts/quality/track-quality-progress.ts",
    "replace-console": "tsx scripts/quality/replace-console-statements.ts",
    "tech-debt:scan": "tsx tools/tech-debt-scanner.ts",
    "tech-debt:gate": "tsx tools/tech-debt-scanner.ts --fail-on medium",
    "quality:monitor": "tsx tools/quality-monitor.ts",
    "quality:monitor:ci": "tsx tools/quality-monitor.ts --strict",
    "quality:trend": "tsx tools/quality-monitor.ts",
    "quality:report": "tsx tools/quality-monitor.ts",
    "unused-imports:scan": "tsx tools/unused-imports-cleaner.ts",
    "code:clean:comments": "tsx tools/commented-code-cleaner.ts",
    "code:clean:todos": "tsx tools/todo-cleaner.ts",
    "code:analyze:complexity": "tsx tools/complexity-analyzer.ts",
    "code:clean:all": "npm run code:clean:comments && npm run code:clean:todos && npm run code:analyze:complexity",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:functional": "tsx scripts/test/run-functional-e2e.ts",
    "test:e2e:ui": "playwright test tests/e2e --ui",
    "test:e2e:debug": "playwright test tests/e2e --debug",
    "test:e2e:headed": "playwright test tests/e2e --headed",
    "test:e2e:chromium": "playwright test tests/e2e --project=chromium",
    "test:e2e:smoke": "playwright test tests/e2e/release-smoke.spec.ts --project=chromium",
    "test:e2e:smoke:release": "playwright test --config=config/playwright.release.config.ts",
    "test:e2e:smoke:compat": "playwright test tests/e2e/release-smoke.spec.ts --project=firefox --project=webkit",
    "test:unit:settings": "vitest run tests/unit/systemSettings tests/unit/ppcSearchTermsSettingsLegacy.test.ts tests/unit/LocalDataStore.test.ts",
    "test:e2e:settings": "playwright test tests/e2e/system-settings.spec.ts --project=chromium",
    "test:settings": "npm run type-check && npm run test:unit:settings && npm run test:e2e:smoke && npm run test:e2e:settings",
    "test:e2e:parallel": "node tests/run-parallel.js",
    "test:e2e:parallel:fast": "node tests/run-parallel.js --workers 4 --skip-firefox --skip-webkit",
    "test:e2e:parallel:all": "node tests/run-parallel.js --enable-mobile",
    "test:e2e:report": "node tests/report-manager.js open",
    "test:e2e:report:generate": "node tests/report-manager.js generate",
    "test:e2e:report:summary": "node tests/report-manager.js summary",
    "test:e2e:report:clean": "node tests/report-manager.js clean",
    "test:e2e:report:archive": "node tests/report-manager.js archive",
    "test:e2e:report:serve": "node tests/report-manager.js serve",
    "test:startup": "playwright test tests/startup --workers=1",
    "test:performance": "npm run test:performance:gate",
    "test:performance:gate": "playwright test --config=config/playwright.performance.config.ts",
    "performance:report": "tsx tests/performance/generate-performance-report.ts",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:visual:headed": "playwright test tests/visual --headed",
    "test:visual:debug": "playwright test tests/visual --debug",
    "test:visual:theme": "node scripts/test/run-theme-visual.mjs",
    "test:theme:matrix": "node scripts/test/theme-matrix-check.mjs",
    "test:visual:theme:update": "node scripts/test/run-theme-visual.mjs --update-snapshots",
    "playwright:install": "playwright install",
    "playwright:install:deps": "playwright install --with-deps",
    "playwright:check": "node tests/check-playwright-env.js",
    "screenshots:stats": "tsx tests/scripts/screenshot-stats.ts",
    "screenshots:cleanup": "tsx tests/scripts/cleanup-screenshots.ts",
    "screenshots:cleanup:all": "tsx tests/scripts/cleanup-screenshots.ts --all",
    "generate:tokens": "tsx scripts/build/generate-all-tokens.ts",
    "generate:css-vars": "tsx scripts/build/generate-css-variables.ts",
    "generate:bridge": "tsx scripts/build/generate-utility-bridge.ts",
    "generate:tailwind": "tsx scripts/build/generate-tailwind-config.ts",
    "generate:types": "tsx scripts/build/generate-design-token-types.ts",
    "ui:audit": "npm run card-ui:audit && npm run callout-ui:audit && npm run workbench-ui:audit",
    "routes:audit": "tsx scripts/quality/audit-routes.ts",
    "page:architecture:audit": "tsx scripts/quality/audit-page-architecture.ts",
    "architecture:audit": "npm run routes:audit && npm run page:architecture:audit",
    "action-names:audit": "tsx scripts/quality/audit-action-names.ts",
    "import-paths:audit": "tsx scripts/quality/audit-import-paths.ts",
    "source-names:audit": "tsx scripts/quality/audit-source-names.ts",
    "card-ui:audit": "tsx scripts/quality/audit-card-ui.ts",
    "callout-ui:audit": "tsx scripts/quality/audit-callout-ui.ts",
    "workbench-ui:audit": "tsx scripts/quality/audit-workbench-ui.ts",
    "css:audit": "tsx scripts/quality/audit-css-variables.ts",
    "theme:hardcode-baseline": "tsx scripts/quality/theme-hardcode-baseline.ts",
    "theme:bridge:gate": "tsx scripts/quality/theme-bridge-gate.ts",
    "theme:hardcode-baseline:all": "tsx scripts/quality/theme-hardcode-baseline.ts --scope all",
    "theme:hardcode-baseline:update": "tsx scripts/quality/theme-hardcode-baseline.ts --update-baseline",
    "theme:hardcode-baseline:gate": "tsx scripts/quality/theme-hardcode-baseline.ts --fail-on-increase",
    "content-surface:baseline": "tsx scripts/quality/content-surface-baseline.ts",
    "content-surface:baseline:update": "tsx scripts/quality/content-surface-baseline.ts --update-baseline",
    "content-surface:gate": "tsx scripts/quality/content-surface-baseline.ts --fail-on-increase",
    "token:override-audit": "tsx scripts/quality/audit-token-overrides.ts",
    "token:override-audit:gate": "tsx scripts/quality/audit-token-overrides.ts --fail-on-unallowlisted-atomic",
    "css:analyze": "tsx scripts/quality/analyze-module-css.ts",
    "css:cleanup": "tsx scripts/dev/cleanup-unused-css.ts",
    "docs:api": "node scripts/build/generate-api-docs.js",
    "docs:serve": "npx http-server docs/api -p 8080 -o",
    "circular:check": "tsx scripts/quality/check-circular-dependencies.ts",
    "ci:security": "npm run xss:gate && npm run secret:scan && npm run circular:check",
    "ci:test-quality": "npm run type-check:tests && npm run lint:tests",
    "ci:format": "npm run format:check",
    "ci:quality": "npm run architecture:audit && npm run css:audit && npm run theme:hardcode-baseline:gate && npm run theme:bridge:gate && npm run content-surface:gate && npm run token:override-audit:gate && npm run action-names:audit && npm run import-paths:audit && npm run source-names:audit && npm run type-check && npm run lint && npm run lint:warning-gate && npm run ci:test-quality && npm run ci:format",
    "ci:all": "npm run ci:security && npm run ci:quality && npm run build:app",
    "release:artifact-contract": "tsx scripts/release/static-artifact-contract.ts dist",
    "release:validate": "tsx scripts/release/prepare-release.ts validate",
    "release:notes": "tsx scripts/release/prepare-release.ts notes",
    "release:package": "tsx scripts/release/prepare-release.ts package",
    "release:backfill-notes": "node scripts/release/backfill-release-notes.mjs",
    "release:sync-all": "node scripts/release/fetch-all-releases.mjs && node scripts/release/sync-all-releases.mjs",
    "release:audit": "node scripts/release/audit-releases.mjs",
    "test:performance:functional": "playwright test --config=config/playwright.functional-performance.config.ts",
    "release:gate": "tsx scripts/release/run-release-gate.ts",
    "release:production-gate": "tsx scripts/release/production-gate.ts"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@types/marked": "^5.0.2",
    "@types/navigo": "^8.1.1",
    "@types/node": "^20.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.4.23",
    "docdash": "^2.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.0.0",
    "fast-check": "^4.5.3",
    "jscpd": "^4.0.5",
    "jsdoc": "^4.0.5",
    "jsdom": "^23.0.0",
    "lighthouse": "12.6.1",
    "lightningcss": "^1.31.1",
    "madge": "^8.0.0",
    "pixelmatch": "^7.1.0",
    "playwright-lighthouse": "^4.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    },
    "tsx": {
      "esbuild": "0.28.1"
    },
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@sentry/browser": "^7.120.4",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "deep-chat": "^2.4.2",
    "fflate": "^0.8.3",
    "flag-icons": "7.3.2",
    "gridstack": "^12.4.2",
    "jsonrepair": "^3.13.2",
    "marked": "^17.0.1",
    "navigo": "^8.11.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  }
}
