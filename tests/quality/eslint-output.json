ullExpression","messageId":"noNonNull","endLine":469,"endColumn":33,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[15630,15631],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":485,"column":37,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":485,"endColumn":53},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":485,"column":55,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":485,"endColumn":75},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":488,"column":27,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":488,"endColumn":50},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":489,"column":30,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":489,"endColumn":53,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[16182,16183],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":502,"column":44,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":502,"endColumn":62,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[16528,16529],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-asse