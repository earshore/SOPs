# ============================================================
# SOPs 项目环境变量配置模板
# ============================================================
# 使用说明：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 修改配置值（特别是 AUTH_PASSWORD 和网关配置）
#   3. 启动开发服务器
#      npm run dev
#   4. 部署到 Cloudflare Pages 时需要配置相同的环境变量
# ============================================================

# ============================================================
# 统一访问密码（必需）
# ============================================================
# 用于 API 认证，前端需要填写此密码才能访问
# 安全建议：使用强密码（至少 16 位，包含大小写字母、数字、特殊字符）
AUTH_PASSWORD=your-secure-password-here

# ============================================================
# 网关配置（至少配置一个网关）
# ============================================================
# 每个网关需要配置以下变量：
#   GATEWAY_{ID}_BASE_URL       - 网关基础地址 (必需)
#   GATEWAY_{ID}_API_KEY        - API 密钥 (必需，支持逗号分隔多 key)
#   GATEWAY_{ID}_DISPLAY_NAME   - 前端显示名称 (可选，默认用 ID)
#   GATEWAY_{ID}_PROTOCOL       - 协议: openai | anthropic (可选，默认 openai)
#
# 注意：
#   - {ID} 必须全大写，如 NEW_API、MYGATEWAY
#   - 实际使用时会转换为小写，如 new_api、mygateway
#   - 下划线会保留，如 NEW_API → new_api
#   - 新增网关只需添加环境变量，无需修改代码！

# ------------------------------------------------------------
# 示例 1: NEW API 网关（主网关）
# ------------------------------------------------------------
GATEWAY_NEW_API_BASE_URL=https://new.hongecb.store/v1
GATEWAY_NEW_API_API_KEY=sk-your-api-key-here
GATEWAY_NEW_API_DISPLAY_NAME=NEW API

# ------------------------------------------------------------
# 示例 2: 自定义 OpenAI 兼容网关
# ------------------------------------------------------------
# GATEWAY_MYGATEWAY_BASE_URL=https://your-gateway.example.com/v1
# GATEWAY_MYGATEWAY_API_KEY=sk-your-api-key
# GATEWAY_MYGATEWAY_DISPLAY_NAME=My Gateway

# ------------------------------------------------------------
# 示例 4: Claude 网关（使用 Anthropic 协议）
# ------------------------------------------------------------
# GATEWAY_CLAUDE_BASE_URL=https://claude-proxy.example.com/v1
# GATEWAY_CLAUDE_API_KEY=sk-your-claude-key
# GATEWAY_CLAUDE_DISPLAY_NAME=Claude Gateway
# GATEWAY_CLAUDE_PROTOCOL=anthropic

# ------------------------------------------------------------
# 多 API Key 负载均衡（可选）
# ------------------------------------------------------------
# 支持为单个网关配置多个 API Key，用逗号分隔
# 系统会自动进行负载均衡
# GATEWAY_NEW_API_API_KEY=sk-key1,sk-key2,sk-key3

# ============================================================
# 前端开发配置（可选）
# ============================================================
# 以下配置仅影响前端开发体验，不影响生产环境

# 应用环境
VITE_APP_ENV=development

# API 配置
VITE_API_BASE_URL=/v1
VITE_API_TIMEOUT=30000

# 功能开关
VITE_ENABLE_MONITORING=false
VITE_ENABLE_DEBUG=true

# 日志配置
VITE_LOG_LEVEL=debug

# 性能监控
VITE_ENABLE_PERFORMANCE=true

# 监控服务（可选）
# VITE_SENTRY_DSN=

# ============================================================
# 部署到 Cloudflare Pages
# ============================================================
# 方式 1: 使用 Wrangler CLI（推荐）
#   1. 创建 secrets.json 文件（包含上述环境变量）
#   2. 运行: npx wrangler pages secret bulk secrets.json --project-name sops
#   3. 删除 secrets.json
#
# 方式 2: 通过 Cloudflare Dashboard
#   1. 登录 Cloudflare Dashboard
#   2. Pages → sops → Settings → Environment variables
#   3. 手动添加每个环境变量
#
# 详细说明请参考: docs/DEPLOYMENT.md
# ============================================================

# ============================================================
# 安全提示
# ============================================================
# ⚠️ 不要将 .env 文件提交到 Git 仓库
# ⚠️ .env 文件已在 .gitignore 中排除
# ⚠️ 生产环境的密钥请使用 Cloudflare Pages 的环境变量功能
# ⚠️ 定期更换 API Key 和密码
# ⚠️ 不要在公开场合分享你的 .env 文件内容
# ============================================================
