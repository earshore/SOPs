{
  "compilerOptions": {
    // 继承主配置
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    // 严格模式（测试环境可以稍微宽松）
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    // 额外检查（测试环境不检查未使用变量）
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // 模块解析
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    // 输出
    "composite": false,
    "declaration": false,
    "sourceMap": true,
    // 跳过库检查
    "skipLibCheck": true,
    // JSX支持
    "jsx": "preserve",
    // 路径映射
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@common/*": [
        "src/common/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@modules/*": [
        "src/modules/*"
      ],
      "@types/*": [
        "src/types/*"
      ]
    },
    // 允许JS文件
    "allowJs": true,
    "checkJs": false,
    // 类型定义（vitest类型）
    "types": [
      "vitest/globals",
      "vite/client",
      "node",
      "@playwright/test"
    ],
    // 类型根目录
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "tests/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "vitest.config.js",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}