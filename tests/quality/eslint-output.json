stants/amz_hub_constants';\nimport { loadTemplate } from '../../../../../common/utils/viewLoader';\nimport { loadChartJs } from '../../../../../common/utils/lazyLibs';\n\nclass EcosystemModule extends BaseModule {\n    private chartInstance: any = null;\n\n    constructor() {\n        super('amz_ecosystem');\n    }\n\n    async render(): Promise<void> {\n        // ✅ 安全: 静态HTML模板，无用户输入\n        this.container!.innerHTML = await loadTemplate(\n            'src/modules/amz_hub/views/knowledge/ecosystem/template.html'\n        );\n    }\n\n    async init(): Promise<void> {\n        await loadChartJs();\n        this.initChart();\n    }\n\n    onUnmount(): void {\n        if (this.chartInstance) {\n            this.chartInstance.destroy();\n            this.chartInstance = null;\n        }\n    }\n\n    initChart(): void {\n        const ctx = document.getElementById('amz_a10Chart') as HTMLCanvasElement;\n        if (!ctx) return;\n\n        if (typeof (window as any).Chart === 'undefined') return;\n\n        const Chart = (window as any).Chart;\n        this.chartInstance = new Chart(ctx.getContext('2d'), {\n            type: 'doughnut',\n            data: A10_CHART_DATA,\n            options: {\n                responsive: true,\n                maintainAspectRatio: false,\n                plugins: {\n                    legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8 } },\n                },\n                cutout: '70%',\n            },\n        });\n    }\n}\n\nconst instance = new EcosystemModule();\nexport const mount = (c: HTMLElement) => instance.mount(c);\nexport const unmount = () => instance.unmount();\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"D:\\Users\\Administrator\\Documents\\GitHub\\AihangSOP\\src\\modules\\amz_hub\\views\\knowledge\\eu_insights\\index.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"messag