# SOPs local environment template
#
# The production app calls the self-hosted new-api gateway directly from the
# browser. These values are only for local verification scripts and manual tests.
#
# Copy this file to `.env` when you need local API checks:
#   cp .env.example .env

GATEWAY_NEW_API_BASE_URL=https://new.hongecb.store/v1
GATEWAY_NEW_API_API_KEY=sk-your-api-key-here

# Optional Vite-only development flags.
VITE_APP_ENV=development
VITE_ENABLE_MONITORING=false
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=debug
VITE_ENABLE_PERFORMANCE=true

# Sentry / production error monitoring (OFF by default).
# Leave VITE_SENTRY_DSN empty unless you intentionally enable Sentry in a production build.
# MonitoringService only initializes in production AND when a DSN is present.
# If you enable Sentry, also allow the DSN ingest host in CSP connect-src (public/_headers + vercel.json).
# VITE_SENTRY_DSN=
