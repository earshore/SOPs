{
  "threshold": 5,
  "reporters": ["json", "console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.min.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/tests/**",
    "**/*.d.ts"
  ],
  "format": ["typescript", "javascript"],
  "minLines": 10,
  "minTokens": 50,
  "maxLines": 500,
  "maxSize": "100kb",
  "output": "./tests/quality"
}
