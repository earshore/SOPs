{
    "name": "aihang-sop",
    "version": "1.0.0",
    "description": "Amazing Amazon Architect - 亚马逊运营管理平台",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:build": "vitest run tests/build/build.test.ts",
        "test:build:sourcemap": "vitest run tests/build/sourcemap-enabled.test.ts",
        "test:build:css": "vitest run tests/build/css-extraction.test.ts",
        "test:build:js": "vitest run tests/build/js-minification.test.ts",
        "test:build:all": "vitest run tests/build/",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "xss:scan": "node tools/xss-scanner.js",
        "xss:fix": "node tools/xss-fixer.js --auto-fix",
        "xss:fix:dry": "node tools/xss-fixer.js --dry-run",
        "security:check": "npm run xss:scan",
        "lighthouse": "lhci autorun",
        "lighthouse:local": "lhci autorun --config=lighthouserc.js",
        "quality:check": "node tests/quality/code-quality-check.ts",
        "quality:coverage": "node tests/quality/coverage-stats.js",
        "quality:dashboard": "node tests/quality/generate-dashboard.js",
        "quality:baseline": "node tests/quality/run-all-checks.js",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:chromium": "playwright test --project=chromium",
        "test:e2e:parallel": "node tests/run-parallel.js",
        "test:e2e:parallel:fast": "node tests/run-parallel.js --workers 4 --skip-firefox --skip-webkit",
        "test:e2e:parallel:all": "node tests/run-parallel.js --enable-mobile",
        "test:e2e:report": "node tests/report-manager.js open",
        "test:e2e:report:generate": "node tests/report-manager.js generate",
        "test:e2e:report:summary": "node tests/report-manager.js summary",
        "test:e2e:report:clean": "node tests/report-manager.js clean",
        "test:e2e:report:archive": "node tests/report-manager.js archive",
        "test:e2e:report:serve": "node tests/report-manager.js serve",
        "test:startup": "playwright test tests/startup",
        "playwright:install": "playwright install",
        "playwright:install:deps": "playwright install --with-deps",
        "playwright:check": "node tests/check-playwright-env.js",
        "screenshots:stats": "tsx tests/scripts/screenshot-stats.ts",
        "screenshots:cleanup": "tsx tests/scripts/cleanup-screenshots.ts",
        "screenshots:cleanup:all": "tsx tests/scripts/cleanup-screenshots.ts --all",
        "screenshots:view": "start tests/screenshots/index.html"
    },
    "devDependencies": {
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.58.2",
        "@types/marked": "^5.0.2",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitest/coverage-v8": "^1.0.0",
        "@vitest/ui": "^1.0.0",
        "autoprefixer": "^10.4.23",
        "docdash": "^2.0.2",
        "eslint": "^8.0.0",
        "fast-check": "^4.5.3",
        "jsdoc": "^4.0.5",
        "jsdom": "^23.0.0",
        "lightningcss": "^1.31.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "terser": "^5.0.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-checker": "^0.6.0",
        "vite-plugin-singlefile": "^2.3.0",
        "vitest": "^1.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.1.0",
        "alpinejs": "^3.15.5",
        "chart.js": "^4.5.1",
        "clsx": "^2.1.1",
        "gridstack": "^12.4.2",
        "jsonrepair": "^3.13.2",
        "marked": "^17.0.1",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    }
}
