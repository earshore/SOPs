{
    "name": "aihang-sop",
    "version": "1.0.0",
    "description": "Amazing Amazon Architect - 亚马逊运营管理平台",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "xss:scan": "node tools/xss-scanner.js",
        "xss:fix": "node tools/xss-fixer.js --auto-fix",
        "xss:fix:dry": "node tools/xss-fixer.js --dry-run",
        "security:check": "npm run xss:scan"
    },
    "devDependencies": {
        "@types/marked": "^5.0.2",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitest/coverage-v8": "^1.0.0",
        "@vitest/ui": "^1.0.0",
        "autoprefixer": "^10.4.23",
        "docdash": "^2.0.2",
        "eslint": "^8.0.0",
        "fast-check": "^4.5.3",
        "jsdoc": "^4.0.5",
        "jsdom": "^23.0.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "terser": "^5.0.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-checker": "^0.6.0",
        "vite-plugin-singlefile": "^2.3.0",
        "vitest": "^1.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.1.0",
        "alpinejs": "^3.15.5",
        "chart.js": "^4.5.1",
        "clsx": "^2.1.1",
        "gridstack": "^12.4.2",
        "jsonrepair": "^3.13.2",
        "marked": "^17.0.1",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.3.6"
    }
}
