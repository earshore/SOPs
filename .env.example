# 环境配置模板
# 复制此文件为 .env.development 或 .env.production 并填写实际值

# 应用环境
VITE_APP_ENV=development

# API 配置
VITE_API_BASE_URL=/v1
VITE_API_TIMEOUT=30000

# 功能开关
VITE_ENABLE_MONITORING=false
VITE_ENABLE_DEBUG=true

# 日志配置
VITE_LOG_LEVEL=debug

# 性能监控
VITE_ENABLE_PERFORMANCE=true

# 监控服务（可选）
# VITE_SENTRY_DSN=

# ============================================================
# 部署前请在 Cloudflare Pages 控制台 → Settings → Environment Variables
# 添加以下生产环境变量：
#
#   AUTH_PASSWORD               = <your-password>
#   GATEWAY_NEW_BASE_URL         = https://new.hongecb.store/v1
#   GATEWAY_NEW_API_KEY          = <your-key>
#   GATEWAY_CPA_BASE_URL         = https://cpa.hongecb.store/v1
#   GATEWAY_CPA_API_KEY          = <your-key>
#   GATEWAY_LLMGATEWAY_BASE_URL = https://ai-gateway.hongecb.store/v1
#   GATEWAY_LLMGATEWAY_API_KEY  = <your-key>
# ============================================================