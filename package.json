{
    "name": "sops",
    "version": "3.0.3-rc.17",
    "description": "sops - 亚马逊运营管理平台",
    "type": "module",
    "scripts": {
        "dev": ".\\scripts\\dev.bat",
        "dev:simple": "vite",
        "dev:open": "vite --open",
        "prebuild": "npm run ci:security && npm run ci:quality",
        "build": "npm run build:app",
        "build:app": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"**/*.spec.ts\" --ignore-pattern \"**/*.spec.tsx\"",
        "lint:tests": "eslint \"src/**/*.{test,spec}.ts\"",
        "lint:fix": "eslint src --fix",
        "lint:warning-gate": "tsx scripts/quality/eslint-warning-gate.ts",
        "lint:warning-baseline": "tsx scripts/quality/eslint-warning-gate.ts --update",
        "lint:report": "tsx tools/eslint-fixer.ts",
        "lint:report:dry": "tsx tools/eslint-fixer.ts --dry-run",
        "format": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --write \"src/**/*.{js,ts,jsx,tsx,json,css,md}\"",
        "format:check": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check \"src/**/*.{js,ts,jsx,tsx,json,css,md}\"",
        "type-check": "tsc --noEmit -p tsconfig.app.json",
        "type-check:tests": "tsc --noEmit",
        "xss:scan": "node tools/security/xss-scanner.js",
        "xss:gate": "node tools/security/xss-scanner.js --fail-on high",
        "xss:fix": "node tools/security/xss-fixer.js --auto-fix",
        "xss:fix:dry": "node tools/security/xss-fixer.js --dry-run",
        "security:check": "npm run xss:scan",
        "security:audit": "tsx tools/security-auditor.ts",
        "lighthouse": "lhci autorun --config=tests/config/lighthouserc.js",
        "lighthouse:local": "lhci autorun --config=tests/config/lighthouserc.js",
        "quality:check": "node tests/quality/code-quality-check.ts",
        "quality:coverage": "node tests/quality/coverage-stats.js",
        "quality:regression": "node tests/quality/regression-audit.js",
        "quality:dashboard": "node tests/quality/generate-dashboard.js",
        "quality:baseline": "node tests/quality/run-all-checks.js",
        "quality:track": "tsx scripts/quality/track-quality-progress.ts",
        "replace-console": "tsx scripts/quality/replace-console-statements.ts",
        "tech-debt:scan": "tsx tools/tech-debt-scanner.ts",
        "quality:monitor": "tsx tools/quality-monitor.ts",
        "quality:monitor:ci": "tsx tools/quality-monitor.ts",
        "quality:trend": "tsx tools/quality-monitor.ts",
        "quality:report": "tsx tools/quality-monitor.ts",
        "unused-imports:scan": "tsx tools/unused-imports-cleaner.ts",
        "code:clean:comments": "tsx tools/commented-code-cleaner.ts",
        "code:clean:todos": "tsx tools/todo-cleaner.ts",
        "code:analyze:complexity": "tsx tools/complexity-analyzer.ts",
        "code:clean:all": "npm run code:clean:comments && npm run code:clean:todos && npm run code:analyze:complexity",
        "test:e2e": "playwright test tests/e2e",
        "test:e2e:ui": "playwright test tests/e2e --ui",
        "test:e2e:debug": "playwright test tests/e2e --debug",
        "test:e2e:headed": "playwright test tests/e2e --headed",
        "test:e2e:chromium": "playwright test tests/e2e --project=chromium",
        "test:e2e:parallel": "node tests/run-parallel.js",
        "test:e2e:parallel:fast": "node tests/run-parallel.js --workers 4 --skip-firefox --skip-webkit",
        "test:e2e:parallel:all": "node tests/run-parallel.js --enable-mobile",
        "test:e2e:report": "node tests/report-manager.js open",
        "test:e2e:report:generate": "node tests/report-manager.js generate",
        "test:e2e:report:summary": "node tests/report-manager.js summary",
        "test:e2e:report:clean": "node tests/report-manager.js clean",
        "test:e2e:report:archive": "node tests/report-manager.js archive",
        "test:e2e:report:serve": "node tests/report-manager.js serve",
        "test:startup": "playwright test tests/startup",
        "test:performance": "playwright test tests/performance",
        "test:performance:home": "playwright test tests/performance/home-performance.test.ts --project=chromium",
        "test:performance:lighthouse": "playwright test tests/performance/lighthouse.test.ts --grep=\"首页\"",
        "performance:report": "tsx tests/performance/generate-performance-report.ts",
        "test:visual": "playwright test tests/visual",
        "test:visual:update": "playwright test tests/visual --update-snapshots",
        "test:visual:headed": "playwright test tests/visual --headed",
        "test:visual:debug": "playwright test tests/visual --debug",
        "playwright:install": "playwright install",
        "playwright:install:deps": "playwright install --with-deps",
        "playwright:check": "node tests/check-playwright-env.js",
        "screenshots:stats": "tsx tests/scripts/screenshot-stats.ts",
        "screenshots:cleanup": "tsx tests/scripts/cleanup-screenshots.ts",
        "screenshots:cleanup:all": "tsx tests/scripts/cleanup-screenshots.ts --all",
        "generate:tokens": "tsx scripts/build/generate-all-tokens.ts",
        "generate:css-vars": "tsx scripts/build/generate-css-variables.ts",
        "generate:tailwind": "tsx scripts/build/generate-tailwind-config.ts",
        "generate:types": "tsx scripts/build/generate-design-token-types.ts",
        "ui:audit": "npm run card-ui:audit && npm run callout-ui:audit && npm run workbench-ui:audit",
        "routes:audit": "tsx scripts/quality/audit-routes.ts",
        "card-ui:audit": "tsx scripts/quality/audit-card-ui.ts",
        "callout-ui:audit": "tsx scripts/quality/audit-callout-ui.ts",
        "workbench-ui:audit": "tsx scripts/quality/audit-workbench-ui.ts",
        "css:audit": "tsx scripts/quality/audit-css-variables.ts",
        "css:analyze": "tsx scripts/quality/analyze-module-css.ts",
        "css:cleanup": "tsx scripts/dev/cleanup-unused-css.ts",
        "docs:api": "node scripts/build/generate-api-docs.js",
        "docs:serve": "npx http-server docs/api -p 8080 -o",
        "circular:check": "madge --circular --extensions ts --ts-config tsconfig.json src",
        "ci:security": "npm run xss:gate && npm run circular:check",
        "ci:test-quality": "npm run type-check:tests && npm run lint:tests",
        "ci:format": "npm run format:check",
        "ci:quality": "npm run type-check && npm run lint && npm run lint:warning-gate && npm run ci:test-quality && npm run ci:format",
        "ci:all": "npm run ci:security && npm run ci:quality && npm run build:app"
    },
    "devDependencies": {
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.58.2",
        "@types/marked": "^5.0.2",
        "@types/navigo": "^8.1.1",
        "@types/node": "^20.0.0",
        "@types/pixelmatch": "^5.2.6",
        "@types/pngjs": "^6.0.5",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitest/coverage-v8": "^4.1.8",
        "@vitest/ui": "^4.1.8",
        "autoprefixer": "^10.4.23",
        "docdash": "^2.0.2",
        "esbuild": "^0.28.1",
        "eslint": "^8.0.0",
        "fast-check": "^4.5.3",
        "jscpd": "^4.0.5",
        "jsdoc": "^4.0.5",
        "jsdom": "^23.0.0",
        "lightningcss": "^1.31.1",
        "madge": "^8.0.0",
        "pixelmatch": "^7.1.0",
        "playwright-lighthouse": "^4.0.0",
        "pngjs": "^7.0.0",
        "postcss": "^8.5.6",
        "prettier": "^3.8.3",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.22.4",
        "typescript": "^5.3.0",
        "vite": "^8.0.16",
        "vite-plugin-singlefile": "^2.3.3",
        "vitest": "^4.1.8"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "9.0.7"
        },
        "tsx": {
            "esbuild": "0.28.1"
        },
        "tmp": "0.2.7",
        "uuid": "11.1.1"
    },
    "dependencies": {
        "@alpinejs/csp": "^3.15.12",
        "@fortawesome/fontawesome-free": "^7.1.0",
        "chart.js": "^4.5.1",
        "clsx": "^2.1.1",
        "deep-chat": "^2.4.2",
        "fflate": "^0.8.3",
        "gridstack": "^12.4.2",
        "jsonrepair": "^3.13.2",
        "marked": "^17.0.1",
        "navigo": "^8.11.1",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    }
}
