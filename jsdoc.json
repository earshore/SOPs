{
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(node_modules|tests|dist|coverage)"
  },
  "opts": {
    "destination": "./docs/api",
    "recurse": true,
    "template": "node_modules/docdash",
    "encoding": "utf8",
    "readme": "README.md"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false,
    "default": {
      "outputSourceFiles": true
    }
  },
  "docdash": {
    "static": true,
    "sort": true
  }
}
