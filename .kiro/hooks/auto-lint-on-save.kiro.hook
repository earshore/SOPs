{
  "enabled": true,
  "name": "Auto Lint on Save",
  "description": "当保存 TypeScript 或 JavaScript 文件时，自动运行 ESLint 检查",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "文件已保存。请使用 #code-quality-checker skill 检查这个文件是否有代码质量问题。如果有问题，建议如何修复。"
  }
}